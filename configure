#!/usr/bin/env bash

CXX_STD=CXX17
JTHREADS=4
if [[ `uname` == 'Darwin' ]] ; then
  CMAKE_BUILD_TYPE=Release
fi
if [[ $TRAVIS -eq true ]] ; then
  CMAKE_BUILD_TYPE=Release
  JTHREADS=2
fi
# Build ITK with 2 jobs (CRAN's limit) unless MAKEFLAGS asks for more,
# e.g. MAKEFLAGS=-j8 R CMD INSTALL ITKR
make_jobs=`echo " ${MAKEFLAGS}" | sed -n -e 's/.*--jobs[= ]*\([0-9][0-9]*\).*/\1/p' -e 's/.* -*[a-zA-Z]*j *\([0-9][0-9]*\).*/\1/p' | head -n 1`
if [ -z "${make_jobs}" ] || [ "${make_jobs}" -lt 1 ]; then
  make_jobs=2
fi
echo "building ITK with ${make_jobs} jobs"
cd ./src
sed "s/@MAKE_JOBS@/${make_jobs}/" Makevars.in > Makevars
itkgit=https://github.com/InsightSoftwareConsortium/ITK
itktag=20edc269b1d9bf9ff27a34db40a438b1b3044f3c # April 28, 2025
# if there is a directory but no git,
# remove it
if [[ -d itks ]]; then
	if [[ ! -d itks/.git ]]; then
		rm -rf itks/
	fi
fi
git_exe=`${R_HOME}/bin/Rscript -e "x=Sys.which('git'); cat(x)"`
if [ -z "${git_exe}" ]; then
    ${R_HOME}/bin/Rscript -e 'if (!requireNamespace("git2r")) install.packages("git2r")'
    str='if (!requireNamespace("git2r")) { install.packages("git2r") }'
    str="${str}; repo = git2r::clone(\""
    str="${str}${itkgit}"
    str="${str}\", local_path = \"./itks\")"
    if [ -n "${itktag}" ]; then
        str="${str}; git2r::checkout(repo, branch = \""
        str="${str}${itktag}"
        str="${str}\");"
    fi
	${R_HOME}/bin/Rscript -e "${str}"
	cd itks
else
	# if no directory, clone it
	if [[ ! -d itks ]]; then
	    git clone $itkgit itks
	fi
	cd itks
	if [[ -d .git ]]; then
	    git checkout master;
	    git checkout $itktag
	fi
fi
rm -rf .git

# GCC 15 no longer pulls in <cstdint> transitively; backport ITK 4f275769e3
# (InsightSoftwareConsortium/ITK#5387) until itktag is bumped past it.
fpefile="./Modules/Core/Common/include/itkFloatingPointExceptions.h"
if [ -f "${fpefile}" ] && ! grep -q '^#include <cstdint>' "${fpefile}"; then
    echo "working on itkFloatingPointExceptions.h for GCC 15 <cstdint>"
    tmpfile="${fpefile}.tmp"
    awk '
        /^#include "itkMacro.h"/ && !done { print "#include <cstdint>"; done = 1 }
        { print }
    ' "${fpefile}" > "${tmpfile}" && mv "${tmpfile}" "${fpefile}"
fi

# Emscripten's <fenv.h> has no FE_INVALID (WebAssembly has no FP exceptions),
# so make HDF5's feclearexcept(FE_INVALID) a no-op there.
h5floatfile="./Modules/ThirdParty/HDF5/src/itkhdf5/src/H5Tinit_float.c"
if [ -f "${h5floatfile}" ] && ! grep -q 'define FE_INVALID' "${h5floatfile}"; then
    echo "working on H5Tinit_float.c for FE_INVALID"
    tmpfile="${h5floatfile}.tmp"
    awk '
        /^#include "H5Tpkg.h"/ && !done { print; print "#ifndef FE_INVALID"; print "#define FE_INVALID 0"; print "#endif"; done = 1; next }
        { print }
    ' "${h5floatfile}" > "${tmpfile}" && mv "${tmpfile}" "${h5floatfile}"
fi

cd ../
if [[ ! -d ../data/ ]] ; then
  mkdir -p ../data
fi
echo "Dependency;GitTag" > ../data/softwareVersions.csv
echo "ITK;${itktag}" >> ../data/softwareVersions.csv
echo "ITKURL;${itkgit}" >> ../data/softwareVersions.csv
mkdir -p itkb
cd itkb
compcflags=" -fPIC -O2 -Wno-c++11-long-long "
compcxxflags=" ${compcflags} "
osx_sysroot=""
if [[ `uname` == 'Darwin' ]] ; then
    osx_sysroot=$(xcrun --sdk macosx --show-sdk-path)
fi
cmaker=`${R_HOME}/bin/Rscript -e "x=Sys.which('cmake'); cat(x)"`
if [[ -z "${cmaker}" ]]; then
	res=`${R_HOME}/bin/Rscript -e "cat(('cmaker' %in% installed.packages())*1)"`
	if [[ $res -eq 0 ]];
		then
	    git clone https://github.com/stnava/cmaker ;
	    R CMD INSTALL cmaker ;
	    rm -rf cmaker ;
	fi
    cmaker=`${R_HOME}/bin/Rscript -e "x=cmaker::cmake()"`
else
	cmaker="cmake"
fi
# WebAssembly (webR / rwasm) builds set CC to emcc; run cmake through emcmake
# so ITK sees the Emscripten toolchain (EMSCRIPTEN set, node for try_run)
# instead of configuring for the Linux host. webR links everything as a side
# module, which breaks executables, so skip ITK's test driver program.
wasm_flags=""
case "${CC}" in
  *emcc*)
    echo "building ITK for WebAssembly with emcmake"
    cmaker="emcmake ${cmaker}"
    wasm_flags="-DDO_NOT_BUILD_ITK_TEST_DRIVER:BOOL=ON"
    ;;
esac

${cmaker} \
    -DCMAKE_BUILD_TYPE:STRING="${CMAKE_BUILD_TYPE}" \
    -DCMAKE_CXX_STANDARD="17"\
    -DCMAKE_CXX_STANDARD_REQUIRED="YES"\
    -DCMAKE_C_FLAGS="${CMAKE_C_FLAGS} ${compcflags} -DNDEBUG  "\
    -DCMAKE_CXX_FLAGS="${CMAKE_CXX_FLAGS} ${compcxxflags} -DNDEBUG  "\
    -DCMAKE_OSX_SYSROOT="${osx_sysroot}"\
    ${wasm_flags} \
    -DITK_USE_GIT_PROTOCOL:BOOL=OFF \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_TESTING:BOOL=OFF \
    -DBUILD_EXAMPLES:BOOL=OFF \
    -DCMAKE_INSTALL_PREFIX:PATH="${R_PACKAGE_DIR}"/libs/  \
    -DITK_LEGACY_REMOVE:BOOL=OFF  \
    -DITK_FUTURE_LEGACY_REMOVE:BOOL=OFF \
    -DITK_BUILD_DEFAULT_MODULES:BOOL=OFF \
    -DModule_AdaptiveDenoising:BOOL=ON \
    -DModule_GenericLabelInterpolator:BOOL=ON \
    -DKWSYS_USE_MD5:BOOL=ON \
    -DITK_WRAPPING:BOOL=OFF \
    -DModule_MGHIO:BOOL=ON \
    -DModule_ITKDeprecated:BOOL=OFF \
    -DModule_ITKReview:BOOL=ON \
    -DModule_ITKVtkGlue:BOOL=OFF \
    -D ITKGroup_Core=ON \
    -D Module_ITKReview=ON \
    -D ITKGroup_Filtering=ON \
    -D ITKGroup_IO=ON \
    -D ITKGroup_Numerics=ON \
    -D ITKGroup_Registration=ON \
    -D ITKGroup_Segmentation=ON ../itks/
cd ../
    # -DModule_ITKDCMTK:BOOL=ON \
